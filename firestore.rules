rules_version = '2';
// Cada conta só enxerga e grava os próprios dados, dentro de users/{uid}.
// Só as coleções que o app usa são aceitas; qualquer outro caminho é negado.
service cloud.firestore {
  match /databases/{database}/documents {
    function dona(uid) { return request.auth != null && request.auth.uid == uid; }

    // imóveis e clientes: o id gravado tem que ser o mesmo do documento
    match /users/{uid}/{col}/{id} {
      allow read, delete: if dona(uid) && col in ['imoveis', 'clientes', 'arquivos', 'perfil'];
      allow create, update: if dona(uid) && (
        (col in ['imoveis', 'clientes'] && request.resource.data.id == id) ||
        // arquivos: pedaços de até 900 KB (o app divide fotos e documentos)
        (col == 'arquivos' && request.resource.data.d is bytes && request.resource.data.d.size() <= 950 * 1024) ||
        (col == 'perfil' && id == 'dados')
      );
    }

    // todo o resto: negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
